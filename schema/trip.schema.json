{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://travel-guide.local/schema/trip.schema.json",
  "title": "Travel Guide trip",
  "description": "One trip. Stored as trips/<slug>/trip.json or trip.json5; the folder name is the trip URL slug. All prices are in trip.currency. All local dates/times are in trip.timezone.",
  "type": "object",
  "required": [
    "schemaVersion",
    "trip",
    "places",
    "days"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "trip": {
      "$ref": "#/$defs/tripSettings"
    },
    "places": {
      "description": "Places catalog. Places not referenced by any stop are shown as the wishlist.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/place"
      }
    },
    "days": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/day"
      }
    },
    "logistics": {
      "$ref": "#/$defs/logistics"
    }
  },
  "patternProperties": {
    "^x-": {}
  },
  "additionalProperties": false,
  "$defs": {
    "id": {
      "title": "Id",
      "description": "Identifier, unique within its collection (places, stops, each logistics list).",
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
    },
    "date": {
      "title": "LocalDate",
      "description": "Local date, YYYY-MM-DD.",
      "type": "string",
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$"
    },
    "time": {
      "title": "LocalTime",
      "description": "Local time, HH:MM (24h).",
      "type": "string",
      "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
    },
    "localDateTime": {
      "title": "LocalDateTime",
      "description": "Local date-time without offset, YYYY-MM-DDTHH:MM. Interpreted in trip.timezone unless a timezone is given next to it.",
      "type": "string",
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])T([01]\\d|2[0-3]):[0-5]\\d$"
    },
    "timezone": {
      "title": "Timezone",
      "description": "IANA timezone name, e.g. Asia/Tokyo.",
      "type": "string",
      "pattern": "^[A-Za-z_]+(/[A-Za-z0-9_+-]+)*$"
    },
    "language": {
      "title": "Language",
      "description": "BCP 47 language tag, e.g. it, en, ja, en-GB.",
      "type": "string",
      "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$"
    },
    "currency": {
      "title": "Currency",
      "description": "ISO 4217 code, e.g. JPY, EUR.",
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "price": {
      "title": "Price",
      "description": "Amount in trip.currency.",
      "type": "number",
      "minimum": 0
    },
    "durationMin": {
      "title": "DurationMin",
      "description": "Duration in minutes.",
      "type": "integer",
      "minimum": 0
    },
    "resource": {
      "title": "Resource",
      "description": "Absolute http(s) URL or a path relative to the trip folder (e.g. audio/museum.mp3).",
      "type": "string",
      "minLength": 1
    },
    "url": {
      "title": "Url",
      "type": "string",
      "pattern": "^https?://"
    },
    "text": {
      "title": "MarkdownText",
      "description": "Free text. Markdown is allowed.",
      "type": "string"
    },
    "geo": {
      "title": "Geo",
      "type": "object",
      "properties": {
        "lat": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "lng": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        }
      },
      "dependentRequired": {
        "lat": [
          "lng"
        ],
        "lng": [
          "lat"
        ]
      }
    },
    "tripSettings": {
      "title": "TripSettings",
      "type": "object",
      "required": [
        "title",
        "startDate",
        "endDate",
        "timezone",
        "currency",
        "language"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "subtitle": {
          "type": "string"
        },
        "description": {
          "$ref": "#/$defs/text"
        },
        "startDate": {
          "$ref": "#/$defs/date"
        },
        "endDate": {
          "$ref": "#/$defs/date"
        },
        "timezone": {
          "$ref": "#/$defs/timezone"
        },
        "currency": {
          "description": "Currency of every price in this file.",
          "$ref": "#/$defs/currency"
        },
        "convertCurrency": {
          "description": "Rough fixed conversion shown next to prices, e.g. 1700 ¥ (≈ 10 €). Not live exchange rates.",
          "type": "object",
          "required": [
            "currency",
            "oneEquals"
          ],
          "properties": {
            "currency": {
              "$ref": "#/$defs/currency"
            },
            "oneEquals": {
              "description": "How many units of trip.currency make 1 unit of this currency. With trip.currency JPY and currency EUR: 170 means 1 € = 170 ¥.",
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "additionalProperties": false
        },
        "language": {
          "description": "Language of the trip content. Also the default UI language when it is it or en.",
          "$ref": "#/$defs/language"
        },
        "cover": {
          "$ref": "#/$defs/resource"
        }
      },
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false
    },
    "openingHours": {
      "title": "OpeningHours",
      "type": "object",
      "properties": {
        "text": {
          "description": "Human-readable hours, shown as is.",
          "type": "string"
        },
        "weekly": {
          "description": "Machine-readable hours used for 'closed at that time' warnings. Missing day = closed. Ranges are HH:MM-HH:MM; an end past midnight may use 24:00-29:59.",
          "type": "object",
          "propertyNames": {
            "enum": [
              "mon",
              "tue",
              "wed",
              "thu",
              "fri",
              "sat",
              "sun"
            ]
          },
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^([01]\\d|2[0-3]):[0-5]\\d-([01]\\d|2[0-9]):[0-5]\\d$"
            }
          }
        },
        "closures": {
          "description": "Human-readable closing days / holidays, e.g. 'Closed on Mondays, or Tuesday if Monday is a holiday'.",
          "type": "string"
        },
        "closedDates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/date"
          }
        }
      },
      "additionalProperties": false
    },
    "audioTrack": {
      "title": "AudioTrack",
      "type": "object",
      "required": [
        "title"
      ],
      "anyOf": [
        {
          "required": [
            "src"
          ]
        },
        {
          "required": [
            "script"
          ]
        }
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "language": {
          "$ref": "#/$defs/language"
        },
        "src": {
          "description": "Audio file (mp3, m4a, ogg), usually relative to the trip folder.",
          "$ref": "#/$defs/resource"
        },
        "durationSec": {
          "type": "integer",
          "minimum": 0
        },
        "transcript": {
          "$ref": "#/$defs/text"
        },
        "script": {
          "description": "Reserved for text-to-speech generation at build time (not implemented yet). Ignored when src is set.",
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "place": {
      "title": "Place",
      "type": "object",
      "required": [
        "id",
        "name"
      ],
      "allOf": [
        {
          "$ref": "#/$defs/geo"
        }
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "description": "Defaults to open. Stops on a closed place raise a warning.",
          "enum": [
            "open",
            "closedTemporarily",
            "closedPermanently"
          ]
        },
        "category": {
          "description": "Free category used for filters, e.g. see, food, shop, fun, hotel, info.",
          "type": "string"
        },
        "icon": {
          "description": "Icon name, e.g. temple, ramen, onsen.",
          "type": "string"
        },
        "stars": {
          "description": "Rating / importance.",
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "veg": {
          "description": "Vegetarian-friendly.",
          "type": "boolean"
        },
        "glutenFree": {
          "type": "boolean"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "description": {
          "description": "Short description (one line).",
          "type": "string"
        },
        "info": {
          "description": "Long description.",
          "$ref": "#/$defs/text"
        },
        "tip": {
          "description": "Practical advice, highlighted in the UI.",
          "$ref": "#/$defs/text"
        },
        "visitDuration": {
          "description": "Suggested visit time as text, e.g. '2-3 hours; 4.5 if you join the workshops'.",
          "type": "string"
        },
        "directions": {
          "description": "How to get there.",
          "$ref": "#/$defs/text"
        },
        "url": {
          "$ref": "#/$defs/url"
        },
        "bookingUrl": {
          "description": "Where to book (hotels, restaurants, tickets).",
          "$ref": "#/$defs/url"
        },
        "image": {
          "$ref": "#/$defs/resource"
        },
        "address": {
          "type": "string"
        },
        "phone": {
          "type": "string"
        },
        "googlePlaceId": {
          "type": "string"
        },
        "openingHours": {
          "$ref": "#/$defs/openingHours"
        },
        "price": {
          "description": "Typical cost (entrance ticket, average meal) as a number. Used when a stop has no price of its own.",
          "$ref": "#/$defs/price"
        },
        "priceInfo": {
          "description": "Price details as text, e.g. 'adults 630 yen, students 210 yen, children free'.",
          "type": "string"
        },
        "audio": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/audioTrack"
          }
        },
        "notes": {
          "$ref": "#/$defs/text"
        }
      },
      "patternProperties": {
        "^x-": {}
      },
      "unevaluatedProperties": false
    },
    "travel": {
      "title": "Travel",
      "description": "How to reach this stop from the previous one (or from day.start for the first stop). Drawn as a route on the day map using the matching Google Maps travel mode.",
      "type": "object",
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "description": "Google Maps mapping: walk -> walking; train, subway, bus, tram, ferry -> transit; taxi, car -> driving; bike -> bicycling; flight, other -> straight line.",
          "enum": [
            "walk",
            "train",
            "subway",
            "bus",
            "tram",
            "ferry",
            "taxi",
            "car",
            "bike",
            "flight",
            "other"
          ]
        },
        "durationMin": {
          "$ref": "#/$defs/durationMin"
        },
        "distanceKm": {
          "description": "Manual distance. When missing, the build computes it (route service, or straight line as a fallback). Walk legs add up to the day's walking km.",
          "type": "number",
          "minimum": 0
        },
        "price": {
          "$ref": "#/$defs/price"
        },
        "line": {
          "description": "Line / service name, e.g. JR Sanyo Line.",
          "type": "string"
        },
        "notes": {
          "$ref": "#/$defs/text"
        }
      },
      "additionalProperties": false
    },
    "dayStart": {
      "title": "DayStart",
      "description": "Where the day starts: a place, an accommodation, or a free point. Defaults to the accommodation of the previous night.",
      "type": "object",
      "anyOf": [
        {
          "required": [
            "placeId"
          ]
        },
        {
          "required": [
            "accommodationId"
          ]
        },
        {
          "required": [
            "title",
            "lat",
            "lng"
          ]
        }
      ],
      "allOf": [
        {
          "$ref": "#/$defs/geo"
        }
      ],
      "properties": {
        "time": {
          "$ref": "#/$defs/time"
        },
        "placeId": {
          "description": "Reference to places[].id.",
          "$ref": "#/$defs/id"
        },
        "accommodationId": {
          "description": "Reference to logistics.accommodations[].id.",
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string"
        },
        "address": {
          "type": "string"
        },
        "notes": {
          "$ref": "#/$defs/text"
        }
      },
      "unevaluatedProperties": false
    },
    "stop": {
      "title": "Stop",
      "type": "object",
      "anyOf": [
        {
          "required": [
            "placeId"
          ]
        },
        {
          "required": [
            "title"
          ]
        }
      ],
      "properties": {
        "id": {
          "description": "Optional but recommended: keeps the 'done' state stable when stops are reordered.",
          "$ref": "#/$defs/id"
        },
        "time": {
          "$ref": "#/$defs/time"
        },
        "placeId": {
          "description": "Reference to places[].id.",
          "$ref": "#/$defs/id"
        },
        "title": {
          "description": "Label for a stop without a place (e.g. 'Lunch around the station'), or an override of the place name.",
          "type": "string"
        },
        "bookedId": {
          "description": "Reference to logistics.reservations[].id. The stop is locked in edit mode: it can only move together with its reservation, and the day date/time must match the reservation.",
          "$ref": "#/$defs/id"
        },
        "durationMin": {
          "$ref": "#/$defs/durationMin"
        },
        "price": {
          "description": "Cost of this stop. Ignored when bookedId points to a reservation with a price; otherwise overrides places[].price.",
          "$ref": "#/$defs/price"
        },
        "travel": {
          "$ref": "#/$defs/travel"
        },
        "audio": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/audioTrack"
          }
        },
        "notes": {
          "$ref": "#/$defs/text"
        }
      },
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false
    },
    "day": {
      "title": "Day",
      "type": "object",
      "required": [
        "date",
        "stops"
      ],
      "properties": {
        "date": {
          "$ref": "#/$defs/date"
        },
        "title": {
          "type": "string"
        },
        "notes": {
          "$ref": "#/$defs/text"
        },
        "start": {
          "$ref": "#/$defs/dayStart"
        },
        "stops": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/stop"
          }
        }
      },
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false
    },
    "accommodation": {
      "title": "Accommodation",
      "type": "object",
      "required": [
        "id",
        "name",
        "checkIn",
        "checkOut"
      ],
      "allOf": [
        {
          "$ref": "#/$defs/geo"
        }
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "placeId": {
          "description": "Optional link to a place in the catalog.",
          "$ref": "#/$defs/id"
        },
        "address": {
          "type": "string"
        },
        "googlePlaceId": {
          "type": "string"
        },
        "checkIn": {
          "anyOf": [
            {
              "$ref": "#/$defs/date"
            },
            {
              "$ref": "#/$defs/localDateTime"
            }
          ]
        },
        "checkOut": {
          "anyOf": [
            {
              "$ref": "#/$defs/date"
            },
            {
              "$ref": "#/$defs/localDateTime"
            }
          ]
        },
        "price": {
          "description": "Total price of the stay.",
          "$ref": "#/$defs/price"
        },
        "url": {
          "$ref": "#/$defs/url"
        },
        "notes": {
          "$ref": "#/$defs/text"
        }
      },
      "patternProperties": {
        "^x-": {}
      },
      "unevaluatedProperties": false
    },
    "transport": {
      "title": "Transport",
      "type": "object",
      "required": [
        "id",
        "type",
        "title"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "enum": [
            "flight",
            "train",
            "bus",
            "ferry",
            "car",
            "pass",
            "other"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        },
        "departure": {
          "$ref": "#/$defs/localDateTime"
        },
        "departureTimezone": {
          "$ref": "#/$defs/timezone"
        },
        "arrival": {
          "$ref": "#/$defs/localDateTime"
        },
        "arrivalTimezone": {
          "$ref": "#/$defs/timezone"
        },
        "validFrom": {
          "description": "For passes.",
          "$ref": "#/$defs/date"
        },
        "validTo": {
          "description": "For passes.",
          "$ref": "#/$defs/date"
        },
        "price": {
          "$ref": "#/$defs/price"
        },
        "url": {
          "$ref": "#/$defs/url"
        },
        "notes": {
          "$ref": "#/$defs/text"
        }
      },
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false
    },
    "reservation": {
      "title": "Reservation",
      "type": "object",
      "required": [
        "id",
        "title",
        "date"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "placeId": {
          "$ref": "#/$defs/id"
        },
        "date": {
          "$ref": "#/$defs/date"
        },
        "time": {
          "$ref": "#/$defs/time"
        },
        "partySize": {
          "type": "integer",
          "minimum": 1
        },
        "price": {
          "$ref": "#/$defs/price"
        },
        "url": {
          "$ref": "#/$defs/url"
        },
        "notes": {
          "$ref": "#/$defs/text"
        }
      },
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false
    },
    "logistics": {
      "title": "Logistics",
      "type": "object",
      "properties": {
        "accommodations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/accommodation"
          }
        },
        "transports": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/transport"
          }
        },
        "reservations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reservation"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
